# Rinova IA — configuración para Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html

# Dominio canónico: https://www.rinovaia.com (fuerza HTTPS y www en un solo salto)
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.rinovaia\.com$ [NC]
RewriteRule ^ https://www.rinovaia.com%{REQUEST_URI} [L,R=301]

# Tipos correctos
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# Caché: HTML y service worker siempre frescos; recursos 30 días
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

ErrorDocument 404 /index.html
